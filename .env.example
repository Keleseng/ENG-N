# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# MARINETRAFFIC_API_KEY: Required for MarineTraffic Live AIS and Vessel API services.
# Users configure this via the Secrets panel in AI Studio UI.
MARINETRAFFIC_API_KEY=YOUR_MARINETRAFFIC_API_KEY
